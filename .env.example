# DemoPilot Environment Variables

NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# Database & Cache (PostgreSQL & Redis)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/demopilot?schema=public"
REDIS_URL="redis://localhost:6379"

# Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="demopilot-development-secret-key-32chars-minimum-sample"

# Google Gemini API
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-pro"
GEMINI_FLASH_MODEL="gemini-1.5-flash"

# Object Storage (Local fallback / S3 / MinIO)
STORAGE_PROVIDER="local" # local, s3, minio
STORAGE_BUCKET="demopilot-media"
STORAGE_PUBLIC_URL="/storage"

# Security & Encryption
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Workers & Browser Isolation
BROWSER_TIMEOUT_MS=60000
MAX_CRAWL_PAGES=15
